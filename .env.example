# ==============================================================================
# GitAI Environment Configuration
# ==============================================================================

# Server settings
GITAI_PORT=8080
PUBLIC_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# LLM Providers (Fill in the ones you plan to use)
# ------------------------------------------------------------------------------

# Anthropic (Claude 3.5 Sonnet / Opus)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o, etc.)
OPENAI_API_KEY=

# OpenRouter (Access to various models)
OPENROUTER_API_KEY=

# Ollama on same machine (host): http://host.docker.internal:11434/v1
# Ollama / LLM on another server in local network: http://192.168.1.100:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Generic LAN OpenAI-compatible server (vLLM / LM Studio / LocalAI / Ollama on LAN)
LAN_LLM_URL=http://192.168.1.100:11434/v1
LAN_LLM_API_KEY=none

# ------------------------------------------------------------------------------
# Model Selection for Roles
# ------------------------------------------------------------------------------
PLANNER_PROVIDER=anthropic
PLANNER_MODEL=claude-opus-5

EDITOR_PROVIDER=anthropic
EDITOR_MODEL=claude-sonnet-5

WORKER_PROVIDER=anthropic
WORKER_MODEL_A=claude-sonnet-5
WORKER_MODEL_B=claude-sonnet-5

# ------------------------------------------------------------------------------
# Sandbox Configuration
# ------------------------------------------------------------------------------
# "docker" uses Docker-outside-of-Docker (requires mounting /var/run/docker.sock)
# "local" runs commands directly inside the container (development only)
SANDBOX_KIND=docker
SANDBOX_IMAGE=docker.io/library/rust:1-slim

# ------------------------------------------------------------------------------
# Forge Integrations (Gitea / Forgejo / GitHub)
# ------------------------------------------------------------------------------

# Local Gitea / Forgejo
GITEA_URL=http://localhost:3000/api/v1
GITEA_TOKEN=
GITEA_WEBHOOK_SECRET=

# GitHub.com
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
